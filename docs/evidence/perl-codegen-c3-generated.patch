diff --git a/lib/Shop/Cart.pm b/lib/Shop/Cart.pm
new file mode 100644
index 0000000..91388b1
--- /dev/null
+++ b/lib/Shop/Cart.pm
@@ -0,0 +1,160 @@
+package Shop::Cart;
+use strict;
+use warnings;
+
+use Carp qw(croak);
+
+our $VERSION = '0.01';
+
+=head1 NAME
+
+Shop::Cart - a small shopping cart with subtotal and tax total
+
+=head1 SYNOPSIS
+
+    use Shop::Cart;
+
+    my $cart = Shop::Cart->new(
+        items    => [ { price => 10, quantity => 2 }, { price => 5, quantity => 1 } ],
+        tax_rate => 0.1,
+    );
+
+    my $subtotal = $cart->subtotal;    # 25
+    my $total    = $cart->total;       # 27.5
+
+=head1 METHODS
+
+=head2 new
+
+    my $cart = Shop::Cart->new(%args);
+
+Constructs a cart. Accepts C<items> (an array reference of hash references
+with C<price> and C<quantity> keys) and C<tax_rate> (a non-negative number).
+Both are optional and default to an empty list and C<0> respectively.
+
+Croaks when the items are malformed, when a price is negative, when a
+quantity is not a positive integer, or when the tax rate is negative.
+
+=cut
+
+sub new {
+    my ( $class, %args ) = @_;
+
+    my $items = exists $args{items} && defined $args{items} ? $args{items} : [];
+    croak 'items must be an array reference'
+        unless ref $items eq 'ARRAY';
+
+    my @items;
+    my $index = 0;
+    for my $item ( @{$items} ) {
+        croak "item at index $index must be a hash reference"
+            unless ref $item eq 'HASH';
+
+        my $price    = $item->{price};
+        my $quantity = $item->{quantity};
+
+        croak "item at index $index has an invalid price: price must be a non-negative number"
+            unless _is_number($price) && $price >= 0;
+
+        croak "item at index $index has an invalid quantity: quantity must be a positive integer"
+            unless _is_number($quantity)
+            && $quantity > 0
+            && $quantity == int $quantity;
+
+        push @items, { %{$item} };
+        $index++;
+    }
+
+    my $tax_rate = exists $args{tax_rate} && defined $args{tax_rate} ? $args{tax_rate} : 0;
+    croak 'tax_rate must be a non-negative number'
+        unless _is_number($tax_rate) && $tax_rate >= 0;
+
+    my $self = {
+        items    => \@items,
+        tax_rate => $tax_rate + 0,
+    };
+
+    return bless $self, $class;
+}
+
+=head2 items
+
+    my @items = @{ $cart->items };
+
+Returns an array reference holding copies of the cart items. The returned
+structure is a copy, so mutating it does not affect the cart.
+
+=cut
+
+sub items {
+    my ($self) = @_;
+    return [ map { { %{$_} } } @{ $self->{items} } ];
+}
+
+=head2 tax_rate
+
+    my $rate = $cart->tax_rate;
+
+Returns the tax rate of the cart.
+
+=cut
+
+sub tax_rate {
+    my ($self) = @_;
+    return $self->{tax_rate};
+}
+
+=head2 subtotal
+
+    my $subtotal = $cart->subtotal;
+
+Returns the sum of C<price * quantity> over all items, without tax. Returns
+C<0> for an empty cart. Does not mutate the supplied items.
+
+=cut
+
+sub subtotal {
+    my ($self) = @_;
+
+    my $subtotal = 0;
+    for my $item ( @{ $self->{items} } ) {
+        $subtotal += $item->{price} * $item->{quantity};
+    }
+
+    return $subtotal;
+}
+
+=head2 total
+
+    my $total = $cart->total;
+
+Returns the subtotal increased by the tax rate. Returns C<0> for an empty
+cart. Does not mutate the supplied items.
+
+=cut
+
+sub total {
+    my ($self) = @_;
+    return $self->subtotal * ( 1 + $self->{tax_rate} );
+}
+
+# Returns true when the given value looks like a plain number.
+sub _is_number {
+    my ($value) = @_;
+
+    return 0 unless defined $value;
+    return 0 if ref $value;
+    return $value =~ /\A \s* [-+]? (?: \d+ (?: \.\d* )? | \.\d+ ) (?: [eE] [-+]? \d+ )? \s* \z/x
+        ? 1
+        : 0;
+}
+
+1;
+
+__END__
+
+=head1 AUTHOR
+
+Shop::Cart contributors
+
+=cut
